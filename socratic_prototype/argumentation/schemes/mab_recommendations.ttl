@prefix arg: <https://example.org/socratic/argumentation/> .
@prefix mab: <https://example.org/socratic/mab/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
arg:recommendedByCriterion a owl:DatatypeProperty .
mab:RewardRank a owl:Class .
mab:recommendEstimatedReward a arg:Scheme ; arg:version "mab-shared-guidance-0.1" ; arg:ruleKind "strict" ;
 arg:premiseVariables "p" ; arg:subjectVariable "option" ; arg:conclusionPredicate arg:recommendedByCriterion ;
 arg:conclusionObject "estimated_reward" ; arg:polarity "positive" ;
 arg:reason "First in the shared public estimated-mean ranking. Equal recorded estimates use fixed option-ID order; this is not a uniquely superior or hidden-optimal option." ;
 arg:query """PREFIX arg: <https://example.org/socratic/argumentation/>
PREFIX task: <https://example.org/socratic/task/>
PREFIX mab: <https://example.org/socratic/mab/>
SELECT DISTINCT ?p ?option WHERE {
 ?rank a mab:RewardRank ; task:forOption ?option .
 ?p a arg:Assertion ; arg:predicate task:value ; arg:scope ?state ; arg:subject ?rank ; arg:object 1 ; arg:polarity "positive" .
}""" .
