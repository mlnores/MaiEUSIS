\@writefile{toc}{\contentsline {section}{\numberline {4}Architecture: separate epistemic and behavioural responsibilities}{7}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Architecture separating participant behaviour, epistemic assessment and intervention delivery. Gold boxes contain private simulation components; the public-event interface restricts the evidence available to the assistant. Below that boundary, numerical models inform an annotated knowledge graph, argumentation evaluates reasons and objections, and a separate policy determines whether and how to intervene. Validated expression returns the intervention to the participant, while the trace retains its evidential and delivery history. Solid arrows show operational flow; dashed arrows show evaluator or trace records.\relax }}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:architecture}{{3}{8}{Architecture separating participant behaviour, epistemic assessment and intervention delivery. Gold boxes contain private simulation components; the public-event interface restricts the evidence available to the assistant. Below that boundary, numerical models inform an annotated knowledge graph, argumentation evaluates reasons and objections, and a separate policy determines whether and how to intervene. Validated expression returns the intervention to the participant, while the trace retains its evidential and delivery history. Solid arrows show operational flow; dashed arrows show evaluator or trace records.\relax }{figure.caption.4}{}}
